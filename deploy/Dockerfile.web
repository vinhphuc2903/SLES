# syntax=docker/dockerfile:1
FROM node:22-alpine@sha256:0e1754758c2df4cfa3e68d59e2e1b7374bb7fd9ea6328eaaacf15cc934af8202 AS build
WORKDIR /build
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
ENV VITE_API_BASE_URL=""
RUN npm run build
# Only core HTTP/TLS/proxy modules are needed; omit optional XSLT/image/perl modules.
FROM nginx:stable-alpine-slim@sha256:e2355aa95529a7999dad94ddcb45a8768abf6fb0b204c93b1a3ffce477d7b893 AS runtime
LABEL org.opencontainers.image.source="https://github.com/vinhphuc2903/SLES" \
      org.opencontainers.image.title="SLES Web"
EXPOSE 8080 8443
COPY --from=build /build/dist/ /usr/share/nginx/html/
COPY deploy/nginx/security-headers.conf /etc/nginx/security-headers.conf
COPY deploy/nginx/nginx.conf /etc/nginx/nginx.conf
COPY deploy/nginx/site.conf.template /etc/nginx/templates/default.conf.template
ENV NGINX_ENVSUBST_FILTER="PUBLIC_HOST"
# Unprivileged ports; image entrypoint renders template before dropping no privileges (already uid101).
RUN chown -R nginx:nginx /etc/nginx/conf.d
USER nginx
HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD wget -q -O /dev/null http://127.0.0.1:8080/healthz || exit 1

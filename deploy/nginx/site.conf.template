server {
    listen 8080 default_server;
    server_name _;
    location = /healthz { access_log off; return 200 'ok'; }
    location /.well-known/acme-challenge/ { root /var/www/acme; }
    location / { return 308 https://${PUBLIC_HOST}$request_uri; }
}
server {
    listen 8443 ssl default_server;
    server_name ${PUBLIC_HOST};
    if ($host != ${PUBLIC_HOST}) { return 444; }
    ssl_certificate /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:TLS:10m;
    ssl_session_tickets off;
    root /usr/share/nginx/html;
    index index.html;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Frame-Options DENY always;
    add_header Permissions-Policy 'camera=(), microphone=(), geolocation=()' always;
    # No HSTS until the real domain strategy and HTTPS are verified.
    location /api/ {
        proxy_pass http://api:8080;
        proxy_http_version 1.1;
        proxy_set_header Host ${PUBLIC_HOST};
        proxy_set_header X-Forwarded-Proto $scheme;
        # Single edge proxy: replace, never append untrusted client-supplied forwarding headers.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header Connection "";
        proxy_read_timeout 65s;
        proxy_send_timeout 65s;
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control no-store always;
    }
    location ^~ /health/ { return 404; }
    location /assets/ {
        try_files $uri =404;
        expires 1y;
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "public, immutable";
    }
    location = /index.html { include /etc/nginx/security-headers.conf; add_header Cache-Control 'no-cache, no-store, must-revalidate'; }
    location / { try_files $uri $uri/ /index.html; }
}

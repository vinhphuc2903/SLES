# syntax=docker/dockerfile:1
FROM mcr.microsoft.com/dotnet/sdk:10.0@sha256:fe0fd4e93bd2fbb47c883b7a6369e5c8d3db8bf01cdc5981f6ee35fbdf3ff4fb AS build
WORKDIR /build
COPY src/ ./src/
RUN dotnet restore src/SLES.Api/SLES.Api.csproj
RUN dotnet publish src/SLES.Api/SLES.Api.csproj -c Release --no-restore -o /out \
    /p:UseAppHost=false && rm -f /out/appsettings.Development.json
FROM mcr.microsoft.com/dotnet/aspnet:10.0@sha256:bfd912c83295ce66d4b706ebb8541b9f14259b0e76fbb88b2751f58ce2399d2e AS runtime
WORKDIR /app
COPY --from=build /out/ ./
ENV ASPNETCORE_HTTP_PORTS=8080 ASPNETCORE_ENVIRONMENT=Staging
USER $APP_UID
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
  CMD ["dotnet", "SLES.Api.dll", "--health-check"]
ENTRYPOINT ["dotnet", "SLES.Api.dll"]

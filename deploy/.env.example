# Copy to .env; scripts/setup generates fresh secrets separately. Never put secret values here.
COMPOSE_PROJECT_NAME=sles-staging
RELEASE_TAG=replace-with-release-id
PUBLIC_HOST=staging.example.invalid
ACME_EMAIL=operator@example.invalid
BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443
PROXY_SUBNET=172.30.80.0/24
PROXY_IP=172.30.80.2
NGINX_SITE_TEMPLATE=./nginx/site.conf.template
BACKUP_DIR=./backups
BACKUP_KEEP=7

DB_NAME=sles_staging
DB_OWNER=sles_owner
DB_APP_USER=sles_app
